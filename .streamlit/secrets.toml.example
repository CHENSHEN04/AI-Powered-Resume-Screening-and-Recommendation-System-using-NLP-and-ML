# ==============================================================================
# Streamlit Secrets Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to: .streamlit/secrets.toml
# 2. Fill in your actual values
# 3. NEVER commit secrets.toml to git!
# ==============================================================================

[supabase]
url = "https://your-project.supabase.co"
anon_key = "your_anon_key_here"
service_role_key = "your_service_role_key_here"

[app]
callback_url = "http://localhost:8501/"
environment = "development"  # "development" or "production"

[admin]
# Generate password hash with:
# python -c "import hashlib; print(hashlib.sha256('your_password'.encode()).hexdigest())"
password_hash = "your_sha256_password_hash_here"

[youtube_api]
# Optional - for dynamic learning resources
key = ""
