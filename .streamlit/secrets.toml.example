# ==============================================================================
# Streamlit Secrets Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to: .streamlit/secrets.toml
# 2. Fill in your actual values
# 3. NEVER commit secrets.toml to git!
# ==============================================================================

[supabase]
url = "https://your-project-id.supabase.co"
anon_key = "your-supabase-anon-key-here"

admin_password = "your-admin-password-here"

[gemini]
GEMINI_API_KEY = "your-gemini-api-key-here"
GEMINI_MODEL = "gemini-2.5-flash"  # optional override

# Free backup API keys (highly recommended for rate-limiting resilience)
GROQ_API_KEY = "your-groq-api-key-here"  # Get free key at console.groq.com
GROQ_MODEL = "llama-3.3-70b-versatile"   # optional override

OPENROUTER_API_KEY = "your-openrouter-api-key-here"  # Get free key at openrouter.ai
OPENROUTER_MODEL = "google/gemma-2-9b-it:free"       # optional override


